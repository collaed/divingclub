parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#2 \$key of static method Illuminate\\Database\\Eloquent\\Builder\<App\\Models\\Event\>\:\:pluck\(\) expects string\|null, Illuminate\\Contracts\\Database\\Query\\Expression given\.$#'
			identifier: argument.type
			count: 2
			path: app/Console/Commands/ImportLegacyData.php

		-
			message: '#^Parameter \#1 \$value of method Carbon\\Carbon\:\:addMonths\(\) expects float\|int, string\|null given\.$#'
			identifier: argument.type
			count: 2
			path: app/Http/Controllers/Admin/EquipmentController.php

		-
			message: '#^Parameter \#2 \$diveGroupMembers of method App\\Services\\UddfService\:\:export\(\) expects array, Illuminate\\Database\\Eloquent\\Collection\<int, App\\Models\\DiveGroupMember\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/DiveDataController.php

		-
			message: '#^Access to an undefined property App\\Models\\DiveSite\:\:\$water_temperature\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/DiveGroupController.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Builder\<TRelatedModel of Illuminate\\Database\\Eloquent\\Model\>\:\:role\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: app/Http/Controllers/HomeController.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Support\\Collection\<int,App\\Models\\MemberDetail\>\:\:filter\(\) expects \(callable\(App\\Models\\MemberDetail, int\)\: bool\)\|null, Closure\(App\\Models\\MemberDetail\)\: \(Carbon\\Carbon\|null\) given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/HomeController.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Support\\Collection\<int,App\\Models\\MemberDetail\>\:\:filter\(\) expects \(callable\(App\\Models\\MemberDetail, int\)\: bool\)\|null, Closure\(App\\Models\\MemberDetail\)\: \(string\|null\) given\.$#'
			identifier: argument.type
			count: 3
			path: app/Http/Controllers/HomeController.php

		-
			message: '#^Parameter \#1 \$num of function number_format expects float, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/QrCodeController.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Support\\Collection\<\(int\|string\),array\<string, mixed\>\>\:\:filter\(\) expects \(callable\(array\{position\: mixed, article\: App\\Models\\Article\|null, teaser\: mixed, custom_url\: mixed, slug\: mixed\}, int\|string\)\: bool\)\|null, Closure\(mixed\)\: \(App\\Models\\Article\|null\) given\.$#'
			identifier: argument.type
			count: 1
			path: app/Models/Newsletter.php

		-
			message: '#^Method App\\Services\\BackupService\:\:create\(\) should return array\{filename\: string, path\: string, size\: int, manifest\: array\} but returns array\{filename\: non\-falsy\-string, path\: non\-falsy\-string, size\: int\<0, max\>\|false, manifest\: null\}\.$#'
			identifier: return.type
			count: 1
			path: app/Services/BackupService.php

		-
			message: '#^Access to an undefined property App\\Models\\BankTransaction\:\:\$transaction_ref\.$#'
			identifier: property.notFound
			count: 1
			path: app/Services/BankReconciliationService.php

		-
			message: '#^Access to an undefined property App\\Models\\DiveSite\:\:\$water_temperature\.$#'
			identifier: property.notFound
			count: 1
			path: app/Services/SwapSuggestionService.php
