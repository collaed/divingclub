			count: 1
			path: app/Console/Commands/EnrichImportedEvents.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: app/Console/Commands/ImportLegacyData.php

		-
			message: '#^Strict comparison using \=\=\= between string\|null and 0 will always evaluate to false\.$#'
