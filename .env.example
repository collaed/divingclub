APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# STAGING_MODE=true
# STAGING_USER=staging
# STAGING_PASS=changeme
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Web cron: secret key for /cron/run?key=YOUR_KEY (use with cron-job.org)
CRON_KEY=change-me
BACKUP_RETENTION=4

# Activity tracking (bureau_master /admin/logins page). last_seen_at is always kept;
# page-visit logging is a support/debugging aid, pruned after TRACKING_RETENTION_DAYS.
# TRACKING_PAGE_VISITS=true
# TRACKING_RETENTION_DAYS=3

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Set a DISTINCT database number per environment when several installs
# (e.g. staging + production) share one Redis instance, otherwise their
# queues and Horizon namespaces collide.
# REDIS_DB=0
# REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_ALWAYS_TO=admin@example.com
# Brevo — one of the providers MailBalancer rotates outgoing mail across
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI / LLM providers (App\Services\LlmClient, article translation, content generation) ---
# Same credentials are expected to work from both staging and production.
# Cloudflare Workers AI — account-scoped inference
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Separate, more broadly-scoped token for the dashboard's account-analytics
# read (neuron-usage chart) — kept apart from CLOUDFLARE_API_TOKEN, which is
# used for inference calls that carry user-uploaded content.
CLOUDFLARE_ANALYTICS_TOKEN=
# Groq — OpenAI-compatible hosted inference (primary chat completion backend)
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_REASONING_EFFORT=low
# 1min.ai
ONEMIN_AI_KEY=
# OpenAI — optional fallback
OPENAI_API_KEY=
# DeepL — optional translation backend
DEEPL_API_KEY=

# Legacy Database (Joomla MySQL - for bidirectional sync)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=clubcepe_joomla
LEGACY_DB_USERNAME=clubcepe_joomla
LEGACY_DB_PASSWORD=
